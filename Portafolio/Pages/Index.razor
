            </div>
        </div>
        <span class="badge bg-primary rounded-pill">@SecurityPercent</span>
    </li>
</ol>

@code {
    private const int FrontPercent = 20;
    private const int BackPercent = 20;
    private const int MobileDeskPercent = 20;
    private const int CloudPercent = 15;
    private const int DbPercent = 15;
    private const int ServerPercent = 1;
    private const int EmbeddedPercent = 1;
    private const int SecurityPercent = 1;

    public void IrA(string url)
    {
#if DEBUG
        navManag.NavigateTo(url);
#else
        navManag.NavigateTo($"/MyPortafolio{url}");
#endif
    }
}
