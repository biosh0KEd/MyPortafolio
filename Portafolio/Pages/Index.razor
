            <div class="fw-bold">Frontend</div>
            <div class="progress" role="progressbar" aria-label="Frontend" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@FrontPercent">
                <div class="progress-bar" style="width: @FrontPercent%;"></div>
            </div>
        </div>
        <span class="badge bg-primary rounded-pill">@FrontPercent</span>
    </li>
    <li class="list-group-item d-flex justify-content-between align-items-start skill-links" @onclick="@(() => IrA("/Backend"))">
        <div class="ms-2 me-auto w-100">
            <div class="fw-bold">Backend</div>
            <div class="progress" role="progressbar" aria-label="Backend" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@BackPercent">
